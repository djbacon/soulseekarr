# Send only the files consumed by Dockerfile to the build daemon.
**
!Dockerfile
!requirements.txt
!app/
!app/**

# Exclude local artifacts and credentials even inside app/.
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.fallow/
**/node_modules/
**/.DS_Store
**/*.swp
**/*.swo
**/*~
**/.env
**/.env.*
**/settings.json
**/secret.key
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.sqlite3-*
**/*.log
**/config/
**/downloads/
